# ---------- Serveur ----------
PORT=4000
NODE_ENV=development
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# ---------- Base de données (PostgreSQL / Supabase) ----------
# Connexion utilisée par l'application (pooler Supabase en production, port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hafiz
# Connexion directe utilisée pour les migrations Prisma (port 5432)
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hafiz

# ---------- Supabase ----------
SUPABASE_URL=https://votre-projet.supabase.co
# Secret JWT (Project Settings > API > JWT Secret) — requis pour les projets
# utilisant le secret HS256 historique. Si absent, l'API vérifie les jetons via
# les clés JWKS publiques du projet (clés asymétriques).
SUPABASE_JWT_SECRET=
# Clé service_role : UNIQUEMENT côté serveur (Supabase Storage). Ne jamais l'exposer au frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hafiz-files

# ---------- Intelligence artificielle ----------
# Fournisseur : openai | mock (mock = réponses simulées, pour le développement et les tests)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optionnel : URL compatible OpenAI (Azure, proxy, etc.)
# OPENAI_BASE_URL=
AI_MAX_HISTORY_MESSAGES=30
